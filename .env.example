X_BEARER_TOKEN=
XAI_API_KEY=
# Optional
HF_TOKEN=
OPENALEX_API_KEY=
# Other LLM providers (optional; choose with `radar setup --llm`)
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
